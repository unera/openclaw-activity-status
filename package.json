{
  "name": "openclaw-activity-status",
  "version": "0.1.0",
  "type": "module",
  "description": "Editable, localized activity status for long-running OpenClaw agent turns.",
  "files": ["dist", "openclaw.plugin.json", "README.md"],
  "engines": {
    "node": ">=24.16.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.8"
  },
  "devDependencies": {
    "openclaw": "2026.9.8",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "compat": {
      "pluginApi": ">=2026.9.8",
      "minGatewayVersion": "2026.9.8"
    },
    "build": {
      "openclawVersion": "2026.9.8",
      "pluginSdkVersion": "2026.9.8"
    }
  }
}
